<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Celia’s Apparel</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f6f6f6;
    }

    header {
      background: black;
      color: white;
      text-align: center;
      padding: 20px;
      font-size: 22px;
      font-weight: bold;
    }

    .intro {
      text-align: center;
      padding: 15px;
      color: #333;
    }

    /* Product grid */
    .container {
      display: grid;
      grid-template-columns: 1fr;
      gap: 15px;
      padding: 15px;
    }

    .card {
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .card img {
      width: 100%;
      height: 300px;
      object-fit: cover;
    }

    .card-content {
      padding: 10px;
    }

    .price {
      color: green;
      font-weight: bold;
      margin-top: 5px;
    }

    /* WhatsApp button */
    .btn {
      display: block;
      text-align: center;
      background: #25D366;
      color: white;
      padding: 10px;
      margin-top: 10px;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
    }

    footer {
      text-align: center;
      padding: 20px;
      font-size: 12px;
      color: gray;
    }

    /* Desktop view */
    @media (min-width: 768px) {
      .container {
        grid-template-columns: 1fr 1fr 1fr;
      }
    }
  </style>
</head>

<body>

<header>
  Celia’s Apparel
</header>

<div class="intro">
  New arrivals available 💃✨<br>
  Tap to order directly on WhatsApp
</div>

<div class="container">

  <!-- PRODUCT 1 -->
  <div class="card">
    <img src="images/photo1.jpg" alt="Product 1">
    <div class="card-content">
      <h3>Luxury Bra Set</h3>
      <p class="price">₦8,500</p>
      <a class="btn" href="https://wa.me/234XXXXXXXXXX?text=I%20want%20the%20Luxury%20Bra%20Set">Order on WhatsApp</a>
    </div>
  </div>

  <!-- PRODUCT 2 -->
  <div class="card">
    <img src="images/photo2.jpg" alt="Product 2">
    <div class="card-content">
      <h3>Gym Wear Set</h3>
      <p class="price">₦6,000</p>
      <a class="btn" href="https://wa.me/234XXXXXXXXXX?text=I%20want%20the%20Gym%20Wear">Order on WhatsApp</a>
    </div>
  </div>

  <!-- PRODUCT 3 -->
  <div class="card">
    <img src="images/photo3.jpg" alt="Product 3">
    <div class="card-content">
      <h3>Night Wear</h3>
      <p class="price">₦5,000</p>
      <a class="btn" href="https://wa.me/234XXXXXXXXXX?text=I%20want%20the%20Night%20Wear">Order on WhatsApp</a>
    </div>
  </div>

</div>

<footer>
  © 2026 codekid12Riema
</footer>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Website</title>

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #f5f5f5;
    }

    h1 {
      text-align: center;
      padding: 20px;
    }

    /* Image gallery */
    .gallery {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 15px;
    }

    .gallery img {
      width: 100%;
      border-radius: 10px;
      object-fit: cover;
    }

    /* Card style */
    .card {
      background: white;
      padding: 10px;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
  </style>
</head>

<body>

  <h1>My Image Page</h1>

  <div class="gallery">

    <div class="card">
      <img src="images/photo1.jpg" alt="Image 1">
      <p>First image</p>
    </div>

    <div class="card">
      <img src="images/photo2.jpg" alt="Image 2">
      <p>Second image</p>
    </div>

    <div class="card">
      <img src="images/photo3.jpg" alt="Image 3">
      <p>Third image</p>
    </div>

  </div>

</body>
</html>
